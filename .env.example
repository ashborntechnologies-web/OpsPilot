# ─────────────────────────────────────────────────────────────────────────────
# OpsPilot environment configuration
#
# NEVER commit a filled-in copy of this file. All secrets are trade secrets
# of OpsPilot. Copy to .env (git-ignored) and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8080
ENV=development
# Reported in X-OpsPilot-Version and /api/v1/meta
VERSION=1.0.0

# ── Auth ─────────────────────────────────────────────────────────────────────
CLERK_SECRET_KEY=sk_test_xxx
CLERK_PUBLISHABLE_KEY=pk_test_xxx

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://user:password@localhost:5432/convdeploy?sslmode=disable
# Redis (Asynq job queue)
REDIS_URL=localhost:6379

# ── AI (Trade Secret) ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxx
# AI prompts — TRADE SECRET — do not commit actual values to source control.
# Provide inline text, or a path to a git-ignored file (prompts/*.txt is ignored).
INTENT_CLASSIFIER_PROMPT=
INTENT_CLASSIFIER_PROMPT_FILE=prompts/intent_classifier.txt
DIAGNOSIS_PROMPT=
DIAGNOSIS_PROMPT_FILE=prompts/diagnosis.txt

# ── AWS ──────────────────────────────────────────────────────────────────────
# Your AWS account ID — embedded in the bootstrap template so users get a
# complete, ready-to-run CloudFormation setup script.
# Find it: aws sts get-caller-identity --query Account --output text
PLATFORM_AWS_ACCOUNT_ID=123456789012

# ── GitHub ───────────────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URL=http://localhost:8080/api/v1/github/callback

# ── Feature Flags ────────────────────────────────────────────────────────────
# Frontend URL (for CORS and WebSocket origin checks)
FRONTEND_URL=http://localhost:3000
# Public URL of this API — used to register GitHub webhooks for PR previews.
# Required in production (behind a proxy the Host header is unreliable).
PUBLIC_API_URL=http://localhost:8080
# Local dev: set to true to allow webhooks pointed at private/loopback addresses
ALLOW_PRIVATE_WEBHOOKS=false
# Encryption key for storing GitHub tokens (min 16 chars; AES key is derived via SHA-256)
ENCRYPTION_KEY=your-32-byte-encryption-key-here!!

# ── Admin ────────────────────────────────────────────────────────────────────
# Optional. Bearer key for the training-data export endpoints (/api/v1/admin/*).
# Endpoints are disabled (404) when unset. The exported datasets are trade secrets.
ADMIN_API_KEY=
