# Server
PORT=8080
ENV=development

# Database
DATABASE_URL=postgres://user:password@localhost:5432/convdeploy?sslmode=disable

# Redis (Asynq job queue)
REDIS_URL=localhost:6379

# Clerk Auth
CLERK_SECRET_KEY=sk_test_xxx
CLERK_PUBLISHABLE_KEY=pk_test_xxx

# GitHub OAuth App
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URL=http://localhost:8080/api/v1/github/callback

# Claude API
ANTHROPIC_API_KEY=sk-ant-xxx

# Encryption key for storing GitHub tokens (32 bytes)
ENCRYPTION_KEY=your-32-byte-encryption-key-here!!

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Public URL of this API — used to register GitHub webhooks for PR previews.
# Required in production (behind a proxy the Host header is unreliable).
PUBLIC_API_URL=http://localhost:8080

# Your AWS account ID — embedded in the bootstrap template so users get a
# complete, ready-to-run CloudFormation setup script.
# Find it: aws sts get-caller-identity --query Account --output text
PLATFORM_AWS_ACCOUNT_ID=123456789012
# Local dev: set to true to allow webhooks pointed at private/loopback addresses
ALLOW_PRIVATE_WEBHOOKS=false
